<div class="traits-container">

  {{!-- Race Info Bar --}}
  <div class="traits-info">
    <span><label>Race:</label> <span class="info-value">{{raceLabel}}</span></span>
    <span><label>Subrace:</label> <span class="info-value">{{subraceLabel}}</span></span>
    <span><label>Proficient Save:</label>
      {{#if isCustomSpecies}}
        <select name="system.customSpeciesSave" class="info-value">
          <option value="impulsive" {{#if (eq system.customSpeciesSave "impulsive")}}selected{{/if}}>Impulsive</option>
          <option value="cognitive" {{#if (eq system.customSpeciesSave "cognitive")}}selected{{/if}}>Cognitive</option>
          <option value="corporeal" {{#if (eq system.customSpeciesSave "corporeal")}}selected{{/if}}>Corporeal</option>
          <option value="morale" {{#if (eq system.customSpeciesSave "morale")}}selected{{/if}}>Morale</option>
        </select>
      {{else}}
        <span class="info-value capitalize">{{system.proficientSave}}</span>
      {{/if}}
    </span>
    <span><label>Current Size:</label> <span class="info-value capitalize">{{system.status.currentSize}}</span></span>
  </div>

  {{!-- Section Header with Add Button --}}
  <div class="section-header">
    Racial Traits
    <button type="button" class="add-btn" data-action="add-trait" title="Add Racial Trait"><i class="fas fa-plus"></i></button>
  </div>
  {{#if @root.rules093}}
  <div class="dbu-factor-toolbar">
    <button type="button" data-action="add-trait" data-racial-factors><i class="fas fa-dna" aria-hidden="true"></i> Racial Factors</button>
  </div>
  <p class="dbu-catalog-description">Adicione o traço da sub-raça com o botão + e marque-o pelo lápis. Racial Factors normalmente trocam um traço secundário, conforme a regra de cada fator.</p>
  {{/if}}

  {{!-- Traits List --}}
  <div class="traits-list">
    {{#if (gt characterTraits.length 0)}}
      {{#each characterTraits}}
      <div class="trait-card{{#if collapsed}} collapsed{{/if}}" data-dbu-share-scope data-trait-id="{{id}}">
        <div class="trait-header">
          {{#if factor}}
          <span class="trait-category-badge factor">Factor</span>
          {{else}}
          <span class="trait-category-badge {{traitCategory}}">{{traitCategory}}</span>
          {{/if}}
          <span class="trait-name">{{name}}</span>
          {{dbuShareRule name}}
          <span class="trait-race-tag">{{#if factor}}{{factor.name}}{{else}}{{#if isSubraceTrait}}Subrace{{else}}{{race}}{{/if}}{{/if}}</span>
          <button type="button" class="trait-expand" data-action="toggle-trait" aria-label="Detalhes de {{name}}" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}">
            <i class="fas fa-chevron-down"></i>
          </button>
          {{#if @root.rules093}}
          {{#if @root.editable}}
          <button type="button" class="dbu-edit-catalog-description" data-dbu-edit-description="traits" data-entry-id="{{id}}" title="Editar descrição e buffs" aria-label="Editar descrição e buffs de {{name}}">
            <i class="fas fa-pen" aria-hidden="true"></i>
          </button>
          {{/if}}
          {{/if}}
          <button type="button" class="delete-btn item-delete" data-action="delete-trait" data-trait-id="{{id}}" title="Remove Trait">
            <i class="fas fa-trash"></i>
          </button>
        </div>
          {{#if (eq id battleBornTraitId)}}
          <div class="bb-inline-display">
            Strike: {{#each ../bbStrikePips}}<span class="bb-pip-mini {{#if filled}}filled{{/if}}"></span>{{/each}}
            | Dodge: {{#each ../bbDodgePips}}<span class="bb-pip-mini {{#if filled}}filled{{/if}}"></span>{{/each}}
            | Wound: {{#each ../bbWoundPips}}<span class="bb-pip-mini {{#if filled}}filled{{/if}}"></span>{{/each}}
            | Total: {{../system.battleBorn.total}}
          </div>
          {{/if}}
        {{#if description}}
        <div class="trait-description dbu-catalog-description" data-dbu-share-text>{{description}}</div>
        {{/if}}
        {{#if source}}<a class="dbu-catalog-source" href="{{source}}" data-dbu-share-source target="_blank" rel="noopener noreferrer">Regra completa no site</a>{{/if}}
          {{#if linkedBuffs.length}}
          <ul class="dbu-linked-buffs" aria-label="Custom Buffs">
            {{#each linkedBuffs}}<li>{{effect}} · {{state}}</li>{{/each}}
          </ul>
          {{/if}}
        <div class="trait-effects-list">
          {{#each effects}}
          <div class="trait-effect {{activationType}}">
            <div data-dbu-share-text>
              <span class="effect-level">Lv.{{level}}</span>
              <span class="effect-keyword {{activationType}}">[{{keyword}}]</span>
              <span class="effect-text">{{#if summary}}{{summary}}{{else}}{{{text}}}{{/if}}</span>
            </div>
            {{#if options}}
            <div class="effect-options">
              {{#if (eq activationType "option")}}
                {{!-- Single option: dropdown --}}
                <select class="option-select" data-trait-id="{{../id}}" data-effect-level="{{level}}" aria-label="{{../name}} Lv.{{level}}" {{#unless @root.editable}}disabled{{/unless}}>
                  {{#if ../rulesVersion}}
                  <option value="" disabled {{#unless hasSelection}}selected{{/unless}}>Escolha uma opção</option>
                  {{/if}}
                  {{#each options}}
                  <option value="{{name}}" {{#if selected}}selected{{/if}}>{{name}}</option>
                  {{/each}}
                </select>
                {{!-- Show selected option text --}}
                {{#each options}}
                  {{#if selected}}
                  <div class="option-detail" data-dbu-share-text>
                    <strong>{{name}}</strong>
                    <span class="option-keyword">[{{keyword}}]</span>
                    <span class="option-text">{{#if summary}}{{summary}}{{else}}{{{text}}}{{/if}}</span>
                  </div>
                  {{#if elementalProfiles}}
                  <label class="option-selector">
                    Favored Element
                    <select class="option-select" data-trait-id="{{../../id}}" data-effect-level="{{../level}}" data-elemental-profile="true" {{#unless @root.editable}}disabled{{/unless}}>
                      <option value="" disabled {{#unless hasSelectedProfile}}selected{{/unless}}>Escolha um Profile Elemental</option>
                      {{#each elementalProfiles}}
                      <option value="{{name}}" {{#if selected}}selected{{/if}}>{{name}}</option>
                      {{/each}}
                    </select>
                  </label>
                  {{/if}}
                  {{/if}}
                {{/each}}
                {{#if ../rulesVersion}}
                <details class="trait-option-previews">
                  <summary>Ver efeitos das opções</summary>
                  <dl>
                    {{#each options}}
                    <dt>{{name}} [{{keyword}}]</dt>
                    <dd>{{summary}}</dd>
                    {{/each}}
                  </dl>
                </details>
                {{/if}}
              {{else if (eq activationType "multi-option")}}
                {{!-- Multi-option: checkboxes --}}
                {{#if optionCount}}<div class="option-limit">{{#if ../rulesVersion}}{{selectedCount}}/{{optionCount}} selecionadas{{else}}Choose up to {{optionCount}} ({{selectedCount}}/{{optionCount}} selected){{/if}}</div>{{/if}}
                {{#each options}}
                <label class="effect-option-checkbox" {{#if selected}}data-dbu-share-text{{/if}}>
                  <input type="checkbox" class="option-checkbox" data-trait-id="{{../../id}}" data-effect-level="{{../level}}" data-option-name="{{name}}" data-max-options="{{../optionCount}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{else unless @root.editable}}disabled{{/if}} />
                  <span class="option-name">{{name}}</span>
                  <span class="option-text">{{#if summary}}{{summary}}{{else}}{{{text}}}{{/if}}</span>
                </label>
                {{/each}}
              {{else if (eq activationType "choice")}}
                {{!-- Choice: shows text based on previous option --}}
                {{#each options}}
                  {{#if selected}}
                  <div class="option-detail choice-detail" data-dbu-share-text>
                    <span class="option-name">{{name}}</span>
                    <span class="option-keyword">[{{keyword}}]</span>
                    <span class="option-text">{{#if summary}}{{summary}}{{else}}{{{text}}}{{/if}}</span>
                  </div>
                  {{/if}}
                {{/each}}
              {{/if}}
            </div>
            {{/if}}
          </div>
          {{/each}}
        </div>
        {{#if isDivergentEvolution}}
        <div class="pb-bestial-section">
          <div class="option-limit">Divergent Evolution — granted Meta Trait{{#unless divergentChosen}} (choose one){{/unless}}</div>
          <div class="bestial-option-row">
            <select class="de-meta-select">
              <option value="">-- Choose Meta Trait --</option>
              {{#each divergentOptions}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
            {{#if divergentChosen.options}}
            <select class="de-meta-config" data-field="option">
              <option value="">-- Option --</option>
              {{#each divergentChosen.options}}
              <option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
            {{/if}}
            {{#if divergentChosen.bestialChoice}}
            <select class="de-meta-config" data-field="bestialTrait">
              <option value="">-- Bestial Trait --</option>
              {{#each divergentChosen.bestialChoice}}
              <option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
            {{/if}}
          </div>
          {{#if divergentChosen}}
          <div class="de-meta-effects">
            {{#each divergentChosen.effects}}
            <div class="de-meta-effect-line">{{this}}</div>
            {{/each}}
          </div>
          {{/if}}
        </div>
        {{/if}}
        {{#if isPartBeast}}
        <div class="pb-bestial-section">
          <div class="option-limit">Bestial Traits — choose 2 ({{partBeastCount}}/2 selected)</div>
          <div class="mut-checkbox-list">
            {{#each partBeastBestial}}
            <label class="effect-option-checkbox {{#if checked}}selected{{/if}} {{#if disabled}}disabled{{/if}}">
              <input type="checkbox" class="pb-bestial-check" data-name="{{id}}" {{#if checked}}checked{{/if}} {{#if disabled}}disabled{{/if}} />
              <span class="option-name">{{name}}</span>
            </label>
            {{#if options}}
            <div class="bestial-option-row" style="margin-left:24px;margin-bottom:4px;">
              <select class="pb-bestial-option" data-trait-id="{{id}}">
                <option value="">-- Choose --</option>
                {{#each options}}
                <option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>
                {{/each}}
              </select>
            </div>
            {{/if}}
            {{/each}}
          </div>
        </div>
        {{/if}}
      </div>
      {{/each}}
    {{else}}
      <div class="empty-message">No racial traits selected. Click <i class="fas fa-plus"></i> to add traits.</div>
    {{/if}}
  </div>

  {{!-- Racial combat bonuses, trackers & activables (moved from the Combat tab) --}}
  <section class="dbu-racial-combat" aria-label="Racial Bonuses &amp; Activables">
    <div class="section-header">Racial Bonuses &amp; Activables</div>
    {{> "systems/DBU-MRR-OLD/templates/actor/parts/combat-racial-bonuses.hbs"}}
  </section>
</div>
