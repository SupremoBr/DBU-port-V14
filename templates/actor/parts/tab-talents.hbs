<div class="talents-container">

  {{!-- Filter Bar --}}
  <div class="talent-filter-bar">
    <div class="talent-filter-controls">
      <label>Category:</label>
      <select class="talent-category-filter" data-action="filter-talents">
        <option value="">All Categories</option>
        {{#each talentCategories}}
        <option value="{{this}}" {{#if (eq this ../selectedTalentCategory)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
    </div>
    <div class="talent-count">
      <span class="talent-visible-count">{{visibleTalentCount}}</span> / <span class="talent-total-count">{{totalTalentCount}}</span> talents
    </div>
  </div>

  {{!-- Section Header with Add Button --}}
  <div class="section-header">
    Character Talents
    <button type="button" class="add-btn" data-action="add-talent" title="Add Talent"><i class="fas fa-plus"></i></button>
  </div>

  {{!-- Talents List (grouped by category) --}}
  <div class="talents-list">
    {{#if (gt characterTalents.length 0)}}
      {{#each talentGroups}}
      <div class="talent-group">
        <div class="talent-group-header">
          <span class="talent-category-badge">{{category}}</span>
          <span class="talent-group-count">({{talents.length}})</span>
        </div>
        {{#each talents}}
        <div class="talent-card" data-dbu-share-scope data-talent-id="{{id}}">
          <div class="talent-header">
            <span class="talent-category-badge">{{category}}</span>
            <span class="talent-name">{{name}}</span>
            <div class="dbu-talent-actions">
            {{dbuShareRule name}}
            {{#if @root.editable}}
            {{#if @root.rules093}}
            <button type="button" class="dbu-edit-catalog-description" data-dbu-edit-description="talents" data-entry-id="{{id}}" title="Editar descrição e buffs" aria-label="Editar descrição e buffs de {{name}}">
              <i class="fas fa-pen" aria-hidden="true"></i>
            </button>
            {{/if}}
            <button type="button" class="delete-btn item-delete" data-action="delete-talent" data-talent-id="{{id}}" title="Remover talento" aria-label="Remover {{name}}">
              <i class="fas fa-trash" aria-hidden="true"></i>
            </button>
            {{/if}}
            </div>
          </div>
          {{#if prerequisites}}
          <div class="talent-prerequisites" data-dbu-share-text><strong>Prerequisites:</strong> {{prerequisites}}</div>
          {{/if}}
          {{#if description}}
          <div class="talent-description dbu-catalog-description" data-dbu-share-text>{{description}}</div>
          {{/if}}
          {{#if source}}<a class="dbu-catalog-source" href="{{source}}" data-dbu-share-source target="_blank" rel="noopener noreferrer">Regra completa no site</a>{{/if}}
          {{#if linkedBuffs.length}}
          <ul class="dbu-linked-buffs" aria-label="Custom Buffs">
            {{#each linkedBuffs}}<li>{{effect}} · {{state}}</li>{{/each}}
          </ul>
          {{/if}}
          <div class="talent-effects-list">
            {{#each effects}}
            <div class="talent-effect {{activationType}}" data-dbu-share-text>
              <span class="effect-level">Lv.{{level}}</span>
              <span class="effect-keyword {{activationType}}">[{{keyword}}]</span>
              <span class="effect-text">{{#if summary}}{{summary}}{{else}}{{{text}}}{{/if}}</span>
            </div>
            {{/each}}
          </div>
          {{#if isArchetypeFocus}}
          <div class="pb-bestial-section">
            <div class="option-limit">Archetype Focus — chosen Foundation (−1 CT Strike/Wound)</div>
            <div class="bestial-option-row">
              <select class="af-foundation-select">
                <option value="">-- Choose Foundation --</option>
                {{#each archetypeFoundationOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>
                {{/each}}
              </select>
            </div>
          </div>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{/each}}
    {{else}}
      <div class="empty-message">No talents selected. Click <i class="fas fa-plus"></i> to add talents.</div>
    {{/if}}
  </div>
</div>
